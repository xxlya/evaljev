# Copy to .env and fill in real values. .env is gitignored — never commit it.
#
# Load into your shell with:
#     set -a; source .env; set +a
#
# Nothing in the package reads .env automatically: the code only ever reads
# os.environ, so the file has no effect until you source it.

# --- Jev / TypeSafe System One (required) -----------------------------------
# Used by JevHTTPClient. Without it, constructing the client raises.
TYPESAFE_API_KEY=replace_me

# Optional: override the System One endpoint.
# TYPESAFE_BASE_URL is not read by the client; pass base_url= to JevHTTPClient.

# --- Claude, via the Vector Institute proxy (optional) ----------------------
# OpenAI-compatible endpoint. Key starts with "vp_".
VECTOR_API_KEY=vp_replace_me

# Optional: override the proxy endpoint.
# VECTOR_BASE_URL=https://proxy.vectorinstitute.ai/v1

# --- Gemini, direct from Google AI Studio (optional) ------------------------
# https://aistudio.google.com/apikey
GEMINI_API_KEY=replace_me
