# Copy this file to .env, then replace each "replace_me" with your real key.
#
#     cp .env.example .env
#     set -a; source .env; set +a
#
# .env is gitignored and will never be committed. Do not quote the values.
#
# The library never reads this file: it only reads os.environ, so sourcing (or
# exporting) is what makes these take effect. examples/router.py is the one
# exception — with the [examples] extra installed it loads this file on start.

# --- Jev decision API (required) --------------------------------------------
# Used by JevHTTPClient -> https://jevtypesafeai.com/api/v1/decide
# Your key starts with "jv_live_".
JEV_API_KEY=jv_live_replace_me

# Optional: override the Jev endpoint.
# JEV_BASE_URL=https://jevtypesafeai.com/api/v1/decide

# --- Claude, via the Vector Institute proxy (optional) ----------------------
# OpenAI-compatible endpoint. Your key starts with "vp_".
VECTOR_API_KEY=vp_replace_me

# Optional: override the proxy endpoint.
# VECTOR_BASE_URL=https://proxy.vectorinstitute.ai/v1

# --- Gemini, direct from Google AI Studio (optional) ------------------------
# https://aistudio.google.com/apikey
GEMINI_API_KEY=replace_me
